# ---- Nivriti Universe API ----
# Port the API listens on
PORT=5000

# MongoDB connection string (MongoDB Atlas or local).
# Leave EMPTY to run in local fallback mode (serves bundled seed content).
# Example (Atlas): mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nivriti
MONGODB_URI=

# Allowed browser origin for CORS in production (your deployed client URL).
# Leave empty in development to allow all origins.
CLIENT_ORIGIN=

# Set NODE_ENV=production on your host.
NODE_ENV=development

# Optional: set REQUIRE_DB=true in production to log a loud error if the DB
# is misconfigured instead of silently serving fallback content.
REQUIRE_DB=false
